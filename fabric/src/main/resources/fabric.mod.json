{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "AI-first Touhou Little Maid Mini companion for Minecraft 26.3.",
  "authors": ["${mod_author}"],
  "license": "${license}",
  "environment": "*",
  "entrypoints": {
    "main": ["com.touhoulittlemaid.mini.fabric.TlmmFabric"],
    "client": ["com.touhoulittlemaid.mini.fabric.TlmmFabricClient"],
    "fabric-gametest": [
      "com.touhoulittlemaid.mini.fabric.gametest.M0GameTests",
      "com.touhoulittlemaid.mini.fabric.gametest.M1CompanionGameTests",
      "com.touhoulittlemaid.mini.fabric.gametest.M1CommandGameTests",
      "com.touhoulittlemaid.mini.fabric.gametest.M1BodyGameTests",
      "com.touhoulittlemaid.mini.fabric.gametest.M2ToolPipelineGameTests",
      "com.touhoulittlemaid.mini.fabric.gametest.M3ContextGameTests",
      "com.touhoulittlemaid.mini.fabric.gametest.M3InventoryGameTests",
      "com.touhoulittlemaid.mini.fabric.gametest.M3MoveInteractGameTests",
      "com.touhoulittlemaid.mini.fabric.gametest.M3PickupContainerGameTests",
      "com.touhoulittlemaid.mini.fabric.gametest.M3DisconnectGameTests",
      "com.touhoulittlemaid.mini.fabric.gametest.M4CropGameTests",
      "com.touhoulittlemaid.mini.fabric.gametest.M4PerformanceGameTests",
      "com.touhoulittlemaid.mini.fabric.gametest.M5BaselineGameTests",
      "com.touhoulittlemaid.mini.fabric.gametest.M6PlanGameTests",
      "com.touhoulittlemaid.mini.fabric.gametest.M6BodyGameTests",
      "com.touhoulittlemaid.mini.fabric.gametest.M6ModulesGameTests",
      "com.touhoulittlemaid.mini.fabric.gametest.M6SemanticGameTests"
    ],
    "fabric-client-gametest": [
      "com.touhoulittlemaid.mini.fabric.gametest.CompanionClientGameTests"
    ]
  },
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": ">=${fabric_version}",
    "minecraft": "${fabric_minecraft_version_range}",
    "java": ">=${java_version}"
  }
}
