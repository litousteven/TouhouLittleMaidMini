{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "AI-first Touhou Little Maid Mini companion for Minecraft 26.3.",
  "authors": ["${mod_author}"],
  "license": "${license}",
  "environment": "*",
  "entrypoints": {
    "main": ["com.touhoulittlemaid.mini.fabric.TlmmFabric"],
    "client": ["com.touhoulittlemaid.mini.fabric.TlmmFabricClient"],
    "fabric-gametest": ["com.touhoulittlemaid.mini.fabric.gametest.M0GameTests"]
  },
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": ">=${fabric_version}",
    "minecraft": "${fabric_minecraft_version_range}",
    "java": ">=${java_version}"
  }
}
